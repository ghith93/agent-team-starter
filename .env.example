# Optional environment variables. Never commit real API keys.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only use verified free model IDs ending in :free
OPENROUTER_FREE_MODELS=
# Optional local FreeLLMAPI gateway; empty key keeps this provider disabled.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_MODEL=auto
