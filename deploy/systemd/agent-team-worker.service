[Unit]
Description=Agent Team durable queue worker
Documentation=https://github.com/ghith93/agent-team-starter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-team
Group=agent-team
WorkingDirectory=/opt/agent-team-starter
EnvironmentFile=/etc/agent-team/worker.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/agent-team-starter/.venv/bin/python -m agent_team.cli --queue-db /var/lib/agent-team/queue.sqlite3 --worker --poll-interval-seconds 5 --lease-seconds 300
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
StateDirectory=agent-team
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/agent-team-starter

[Install]
WantedBy=multi-user.target
